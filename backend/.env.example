# ATS backend — environment template (arch. doc §40)
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql://ats:ats_dev_password@localhost:5432/ats
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_STATEMENT_TIMEOUT_MS=15000

# --- JWT / Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
# JSON list of allowed origins (Flutter web / admin frontends)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# --- Object storage (S3/MinIO placeholders — local disk used when unset) ---
# S3_ENDPOINT=
# S3_BUCKET=ats-receipts
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
