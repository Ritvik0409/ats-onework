<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9 (API 28) blocks cleartext HTTP by default, so the app could
  not reach a plain-HTTP development backend even with the INTERNET
  permission present.

  Cleartext stays enabled for the local development hosts only. Every
  other destination — including anything in production — must use HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- The Android emulator's alias for the host machine. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- The host machine itself, for a device on the same network. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
