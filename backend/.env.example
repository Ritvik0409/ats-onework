# ATS backend — environment template (arch. doc §40)
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (direct Postgres connection — Docker optional) ---
# Point these at ANY real PostgreSQL server, local or remote. Create the
# role + database out-of-band, e.g. with psql as a superuser:
#   CREATE ROLE ats WITH LOGIN PASSWORD 'ats_dev_password' CREATEDB;
#   CREATE DATABASE ats OWNER ats;
DB_HOST=localhost
DB_PORT=5432
DB_USER=ats
DB_PASSWORD=ats_dev_password
DB_NAME=ats

# Full-DSN escape hatch — when set, it wins over DB_* above:
# DATABASE_URL=postgresql://ats:ats_dev_password@localhost:5432/ats

# Integration-test database (§41). With DB_* credentials present, the test
# harness provisions a throwaway <DB_NAME>_test database (create → migrate
# → test → drop) — the development database is never touched.
# Per-test overrides for the test server/user/db:
# TEST_DB_HOST=
# TEST_DB_PORT=
# TEST_DB_USER=
# TEST_DB_PASSWORD=
# TEST_DB_NAME=ats_test

# Full-DSN escape hatch for tests — caller owns the database entirely:
# TEST_DATABASE_URL=postgresql://.../ats_test

DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_STATEMENT_TIMEOUT_MS=15000

# --- JWT / Auth ---
# REQUIRED in production — the server refuses to start with the placeholder
# below. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Outside production an unset JWT_SECRET falls back to a random per-process
# key, so the published value is never used to sign real tokens.
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Password for the accounts created by scripts/seed.py. When unset the
# seeder generates a random one and prints it. Set it to keep a stable
# development login.
# SEED_PASSWORD=

# --- CORS ---
# JSON list of allowed origins (Flutter web / admin frontends). Production
# uses this list only — the localhost pattern is development-only.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# --- Object storage (S3/MinIO placeholders — local disk used when unset) ---
# S3_ENDPOINT=
# S3_BUCKET=ats-receipts
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
